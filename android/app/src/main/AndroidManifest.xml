<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ===== JARVIS permissions (sirf wahi, jo code me sach me use hota hai) =====
         RECORD_AUDIO : mic se speech recognition (speech_to_text)
         INTERNET     : AI provider ka HTTPS request
         CALL_PHONE / SEND_SMS jaan-boojh ke NAHI daale gaye: v1 me call/SMS sirf
         user-confirmed system screen (ACTION_DIAL / ACTION_SENDTO) se hota hai,
         jiske liye permission ki zaroorat nahi. Jab tak koi tool unpermissioned
         action ko actually implement na kare, permission manifest me nahi aayegi.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="JARVIS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Flutter UI initialize hone se pehle ka splash theme. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- ===== Android 11+ package visibility =====
         In <queries> ke bina resolveActivity()/queryIntentActivities() null/empty
         return karte hain, yani "app khulo" / "website kholo" chup-chaap fail ho
         jata. Yahi wajah hai ki ye entries documentation-driven hain, optional nahi.
    -->
    <queries>
        <!-- Android SpeechRecognizer service (speech_to_text) -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Android TextToSpeech engine (flutter_tts) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- ProcessText plugin (Flutter engine) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Browser / http links (url_launcher, Phase 6) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Share sheet (Phase 6) -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Dialer screen (Phase 6, user-confirmed call) -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Kitni launchable apps hain, ye janana "X app kholo" tool ke liye -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
